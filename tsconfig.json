{
  // Typecheck for framework-independent packages and scripts. Source runs directly
  // on Node >= 22.18 via built-in type stripping, so only erasable syntax is allowed
  // (no enums, namespaces, or parameter properties) and relative imports carry `.ts`.
  // The portal keeps its own Next.js tsconfig.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "scripts/**/*.ts"]
}
